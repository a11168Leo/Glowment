# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados do seu projeto.
# Supabase > Project Settings > API Keys (ou Data API).
# Use a chave "publishable" (ou a antiga "anon"). NUNCA coloque aqui a "secret"/"service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
